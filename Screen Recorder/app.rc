// Screen Recorder - resources
// Program icon (shown in File Explorer and the taskbar)
1 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Screen Recorder"
            VALUE "ProductName", "Screen Recorder"
            VALUE "FileVersion", "1.2.0"
            VALUE "ProductVersion", "1.2.0"
            VALUE "OriginalFilename", "Screen Recorder.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
