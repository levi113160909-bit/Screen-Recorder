// Screen Recorder - resources
// Program icon (shown in File Explorer and the taskbar)
#pragma code_page(65001)   // Version.h is UTF-8
#include "Version.h"

1 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
 PRODUCTVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Screen Recorder"
            VALUE "ProductName", "Screen Recorder"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "ProductVersion", APP_VERSION_STR
            VALUE "OriginalFilename", "Screen Recorder.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
